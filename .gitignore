# Publish only the contents of static/. These root links keep the old Caddy
# document root working until it switches to that directory.
/android-chrome-*.png
/apple-touch-icon.png
/assets
/bible-text
/bible-version-catalog.msgpack
/encrypted-files
/favicon*
/index.html
/offline-content-manifest.json
/private-content-manifest.json
/question-banks
/site.webmanifest
/sw.js
/workbox-*.js
/.nojekyll
/CNAME

# Encrypted files are force-added from .github/private-content-files.txt when preparing a
# release. Ciphertext that is not listed there is obsolete and is deleted, which keeps the
# published site under the GitHub Pages size limit.
/static/encrypted-files/*
